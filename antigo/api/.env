# Copie para ".env" (mesma pasta do config.php) e preencha.
# Esse arquivo NÃO deve ficar acessível publicamente pelo navegador —
# se sua hospedagem servir tudo dentro de public_html, coloque-o um
# nível ACIMA de public_html se possível, ou bloqueie o acesso via .htaccess
# (já incluído um bloqueio abaixo, em api/.htaccess).

DB_HOST=localhost
DB_PORT=3306
DB_NAME=trainly
DB_USER=root
DB_PASSWORD=
JWT_SECRET=qualquer-frase-aleatoria-aqui

# String longa e aleatória usada para assinar os tokens de login.
JWT_SECRET=troque-isto-por-algo-longo-e-aleatorio
