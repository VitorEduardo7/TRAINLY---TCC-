# Só é usado se o site voltar para o banco antigo (DATA_SOURCE = "mysql" em
# js/supabase-config.js). Copie este arquivo para ".env" (mesma pasta) e preencha.
# O ".env" NÃO vai para o GitHub (está no .gitignore).

DB_HOST=localhost
DB_PORT=3306
DB_NAME=trainly
DB_USER=root
DB_PASSWORD=

# String longa e aleatória usada para assinar os tokens de login.
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
